###
###  Auth: citizen OTP flow 
###

# @name otpRequest
POST {{host}}/auth/otp/request
Content-Type: {{json}}

{
  "nationalId": "{{nationalId}}"
}

###
# Non-production returns `devOtp`. In production this would fail.
# @name otpVerify
POST {{host}}/auth/otp/verify
Content-Type: {{json}}

{
  "nationalId": "{{nationalId}}",
  "code": "{{otpRequest.response.body.$.devOtp}}"
}

###
@citizenToken = {{otpVerify.response.body.$.token}}

### Who am I (citizen)
GET {{host}}/me
Authorization: Bearer {{citizenToken}}

### Request a second OTP for another citizen (cooldown is 60s per ID)
POST {{host}}/auth/otp/request
Content-Type: {{json}}

{
  "nationalId": "{{nationalId2}}"
}

### Wrong code — expect 401
POST {{host}}/auth/otp/verify
Content-Type: {{json}}

{
  "nationalId": "{{nationalId}}",
  "code": "000000"
}


